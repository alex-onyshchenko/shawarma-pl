{
	servers {
		protocols h1 h2
	}
}

{$API_HOST} {
	encode zstd gzip

	@admin path /admin /admin/* /api/admin /api/admin/*
	handle @admin {
		basic_auth bcrypt "Shaurmisha Admin" {
			{$ADMIN_BASIC_USER} {$ADMIN_BASIC_HASH}
		}
		@adminApi path /api/admin /api/admin/*
		handle @adminApi {
			reverse_proxy sync:3002
		}
		handle {
			reverse_proxy admin:80
		}
	}

	handle {
		reverse_proxy sync:3002
	}
}
