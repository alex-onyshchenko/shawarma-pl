{
  "name": "@shawarma/sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env.prod server.js",
    "dev": "node --env-file-if-exists=.env.dev --watch server.js",
    "check": "node --check server.js",
    "test": "node --test",
    "start:dev": "node --env-file-if-exists=.env.dev server.js",
    "start:prod": "node --env-file-if-exists=.env.prod server.js"
  }
}
